generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-tenancy ────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  departments Department[]
  employees   Employee[]
  leaveTypes  LeaveType[]
  payrollRuns PayrollRun[]

  // FI
  glAccounts    GLAccount[]
  fiscalYears   FiscalYear[]
  journalEntries JournalEntry[]

  // MM
  materials             Material[]
  vendors               Vendor[]
  purchaseRequisitions  PurchaseRequisition[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]

  // SD
  customers        Customer[]
  salesOrders      SalesOrder[]
  deliveries       Delivery[]
  customerInvoices CustomerInvoice[]
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  tenantId       String
  name           String?
  email          String
  hashedPassword String
  role           UserRole @default(EMPLOYEE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  employee Employee?

  @@unique([tenantId, email])
}

enum UserRole {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

// ─── Organisation ─────────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@unique([tenantId, name])
}

// ─── Employees ────────────────────────────────────────────────────────────────

model Employee {
  id             String         @id @default(cuid())
  tenantId       String
  userId         String?        @unique
  employeeCode   String
  firstName      String
  lastName       String
  email          String
  phone          String?
  departmentId   String?
  jobTitle       String?
  employmentType EmploymentType @default(FULL_TIME)
  status         EmployeeStatus @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime?
  baseSalary     Decimal        @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  payrollItems  PayrollItem[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

// ─── Leave ────────────────────────────────────────────────────────────────────

model LeaveType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  daysPerYear Int
  isPaid      Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  leaveRequests LeaveRequest[]

  @@unique([tenantId, name])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  days        Int
  reason      String?
  status      LeaveStatus @default(PENDING)
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ─── Payroll ──────────────────────────────────────────────────────────────────

model PayrollRun {
  id        String        @id @default(cuid())
  tenantId  String
  period    String
  status    PayrollStatus @default(DRAFT)
  runAt     DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  payrollItems PayrollItem[]

  @@unique([tenantId, period])
}

model PayrollItem {
  id           String   @id @default(cuid())
  payrollRunId String
  employeeId   String
  baseSalary   Decimal  @db.Decimal(12, 2)
  allowances   Decimal  @db.Decimal(12, 2) @default(0)
  deductions   Decimal  @db.Decimal(12, 2) @default(0)
  tax          Decimal  @db.Decimal(12, 2) @default(0)
  netSalary    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@index([employeeId])
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

// ─── FI: Chart of Accounts ────────────────────────────────────────────────────

model GLAccount {
  id          String        @id @default(cuid())
  tenantId    String
  code        String
  name        String
  type        GLAccountType
  isActive    Boolean       @default(true)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  journalLines     JournalEntryLine[]
  vendors          Vendor[]
  customers        Customer[]

  @@unique([tenantId, code])
}

enum GLAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// ─── FI: Fiscal Year ──────────────────────────────────────────────────────────

model FiscalYear {
  id        String           @id @default(cuid())
  tenantId  String
  year      Int
  startDate DateTime         @db.Date
  endDate   DateTime         @db.Date
  status    FiscalYearStatus @default(OPEN)
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, year])
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

// ─── FI: Journal Entry (Universal Journal) ────────────────────────────────────

model JournalEntry {
  id          String              @id @default(cuid())
  tenantId    String
  number      String
  date        DateTime            @db.Date
  description String
  status      JournalEntryStatus  @default(DRAFT)
  source      JournalEntrySource  @default(MANUAL)
  sourceId    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  lines  JournalEntryLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, source, sourceId], name: "unique_source_posting")
  @@index([tenantId, status])
  @@index([tenantId, date])
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalEntrySource {
  MANUAL
  AP
  AR
  PAYROLL
  INVENTORY
  GOODS_ISSUE
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  glAccountId    String
  debit          Decimal  @db.Decimal(14, 2) @default(0)
  credit         Decimal  @db.Decimal(14, 2) @default(0)
  description    String?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  glAccount    GLAccount    @relation(fields: [glAccountId], references: [id])

  @@index([journalEntryId])
  @@index([glAccountId])
}

// ─── MM: Material Master ──────────────────────────────────────────────────────

model Material {
  id           String       @id @default(cuid())
  tenantId     String
  code         String
  name         String
  description  String?
  type         MaterialType @default(RAW)
  unit         String       @default("EA")
  standardPrice Decimal     @db.Decimal(12, 2) @default(0)
  stockQty     Decimal      @db.Decimal(14, 3) @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  prItems        PRItem[]
  poItems        POItem[]
  grItems        GRItem[]
  soItems        SOItem[]
  deliveryItems  DeliveryItem[]

  @@unique([tenantId, code])
}

enum MaterialType {
  RAW
  FINISHED
  SEMIFINISHED
  SERVICE
  TRADING
}

// ─── MM: Vendor (Business Partner - Supplier) ─────────────────────────────────

model Vendor {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?
  glAccountId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  glAccount      GLAccount?      @relation(fields: [glAccountId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([glAccountId])
}

// ─── MM: Purchase Requisition ─────────────────────────────────────────────────

model PurchaseRequisition {
  id          String    @id @default(cuid())
  tenantId    String
  number      String
  requestedBy String
  date        DateTime  @db.Date
  status      PRStatus  @default(DRAFT)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  items          PRItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

enum PRStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
}

model PRItem {
  id             String   @id @default(cuid())
  prId           String
  materialId     String
  quantity       Decimal  @db.Decimal(14, 3)
  estimatedPrice Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  pr       PurchaseRequisition @relation(fields: [prId], references: [id])
  material Material            @relation(fields: [materialId], references: [id])

  @@index([prId])
  @@index([materialId])
}

// ─── MM: Purchase Order ───────────────────────────────────────────────────────

model PurchaseOrder {
  id          String    @id @default(cuid())
  tenantId    String
  number      String
  vendorId    String
  prId        String?
  date        DateTime  @db.Date
  status      POStatus  @default(DRAFT)
  totalAmount Decimal   @db.Decimal(14, 2) @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  vendor        Vendor               @relation(fields: [vendorId], references: [id])
  pr            PurchaseRequisition? @relation(fields: [prId], references: [id])
  items         POItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([tenantId, number])
  @@index([vendorId])
  @@index([prId])
  @@index([tenantId, status])
}

enum POStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model POItem {
  id         String   @id @default(cuid())
  poId       String
  materialId String
  quantity   Decimal  @db.Decimal(14, 3)
  unitPrice  Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  po       PurchaseOrder @relation(fields: [poId], references: [id])
  material Material      @relation(fields: [materialId], references: [id])
  grItems  GRItem[]

  @@index([poId])
  @@index([materialId])
}

// ─── MM: Goods Receipt ────────────────────────────────────────────────────────

model GoodsReceipt {
  id              String    @id @default(cuid())
  tenantId        String
  number          String
  poId            String
  date            DateTime  @db.Date
  status          GRStatus  @default(DRAFT)
  journalEntryId  String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  po      PurchaseOrder @relation(fields: [poId], references: [id])
  items   GRItem[]

  @@unique([tenantId, number])
  @@index([poId])
  @@index([tenantId, status])
}

enum GRStatus {
  DRAFT
  CONFIRMED
  REVERSED
}

model GRItem {
  id               String   @id @default(cuid())
  grId             String
  poItemId         String
  materialId       String
  quantityReceived Decimal  @db.Decimal(14, 3)
  createdAt        DateTime @default(now())

  gr       GoodsReceipt @relation(fields: [grId], references: [id])
  poItem   POItem       @relation(fields: [poItemId], references: [id])
  material Material     @relation(fields: [materialId], references: [id])

  @@index([grId])
  @@index([poItemId])
  @@index([materialId])
}

// ─── SD: Customer (Business Partner - Customer) ───────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  email       String?
  phone       String?
  address     String?
  creditLimit Decimal  @db.Decimal(14, 2) @default(0)
  glAccountId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  glAccount        GLAccount?        @relation(fields: [glAccountId], references: [id])
  salesOrders      SalesOrder[]
  customerInvoices CustomerInvoice[]

  @@unique([tenantId, code])
  @@index([glAccountId])
}

// ─── SD: Sales Order ──────────────────────────────────────────────────────────

model SalesOrder {
  id          String          @id @default(cuid())
  tenantId    String
  number      String
  customerId  String
  date        DateTime        @db.Date
  status      SalesOrderStatus @default(DRAFT)
  totalAmount Decimal         @db.Decimal(14, 2) @default(0)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])
  items      SOItem[]
  deliveries Delivery[]
  invoices   CustomerInvoice[]

  @@unique([tenantId, number])
  @@index([customerId])
  @@index([tenantId, status])
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  BILLED
  CANCELLED
}

model SOItem {
  id         String   @id @default(cuid())
  soId       String
  materialId String
  quantity   Decimal  @db.Decimal(14, 3)
  unitPrice  Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  so           SalesOrder   @relation(fields: [soId], references: [id])
  material     Material     @relation(fields: [materialId], references: [id])
  deliveryItems DeliveryItem[]

  @@index([soId])
  @@index([materialId])
}

// ─── SD: Delivery ─────────────────────────────────────────────────────────────

model Delivery {
  id             String         @id @default(cuid())
  tenantId       String
  number         String
  soId           String
  date           DateTime       @db.Date
  status         DeliveryStatus @default(DRAFT)
  journalEntryId String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  so      SalesOrder   @relation(fields: [soId], references: [id])
  items   DeliveryItem[]
  invoices CustomerInvoice[]

  @@unique([tenantId, number])
  @@index([soId])
  @@index([tenantId, status])
}

enum DeliveryStatus {
  DRAFT
  PICKED
  SHIPPED
  DELIVERED
}

model DeliveryItem {
  id         String   @id @default(cuid())
  deliveryId String
  soItemId   String
  materialId String
  quantity   Decimal  @db.Decimal(14, 3)
  createdAt  DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  soItem   SOItem   @relation(fields: [soItemId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@index([deliveryId])
  @@index([soItemId])
  @@index([materialId])
}

// ─── SD: Customer Invoice ─────────────────────────────────────────────────────

model CustomerInvoice {
  id             String                @id @default(cuid())
  tenantId       String
  number         String
  customerId     String
  soId           String
  deliveryId     String?
  date           DateTime              @db.Date
  dueDate        DateTime              @db.Date
  amount         Decimal               @db.Decimal(14, 2)
  status         CustomerInvoiceStatus @default(DRAFT)
  journalEntryId String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  customer Customer   @relation(fields: [customerId], references: [id])
  so       SalesOrder @relation(fields: [soId], references: [id])
  delivery Delivery?  @relation(fields: [deliveryId], references: [id])

  @@unique([tenantId, number])
  @@index([soId])
  @@index([deliveryId])
  @@index([customerId])
  @@index([tenantId, status])
}

enum CustomerInvoiceStatus {
  DRAFT
  POSTED
  PAID
  CANCELLED
}
